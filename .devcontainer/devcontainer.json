{
    "name": "Symfony PHP 8.3 & PostgreSQL",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",

    // Forward the development server and the Nginx-served production build.
    "forwardPorts": ["nginx:80", 5173],

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },

    "postCreateCommand": "composer install && npm --prefix frontend ci && npm --prefix frontend run build",

    // Установка полезных расширений VS Code
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    // Использование пользователя vscode, созданного в Dockerfile
    "remoteUser": "vscode"
}
